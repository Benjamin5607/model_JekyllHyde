# Copy to secrets/.env (gitignored) and fill in values.

# === Agent fast path (Groq) ===
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.1-8b-instant
JH_AGENT_BACKEND=groq

# === API 24/7 (Ollama — local or Oracle VM) ===
JH_API_BACKEND=ollama
JH_OLLAMA_URL=http://127.0.0.1:11434
JH_OLLAMA_JEKYLL=jekyll-hyde-jekyll
JH_OLLAMA_HYDE=jekyll-hyde-hyde

# === HF (gated Gemma download / upload only) ===
HF_TOKEN=hf_your_token_here

# === Demo Space (browser) ===
JH_HF_SPACE_URL=https://benjamin5607-jekyll-hyde-demo.hf.space
